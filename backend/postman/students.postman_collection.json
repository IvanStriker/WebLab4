                  "pm.test(\"Статус 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Добавить: некорректные данные (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": -1,\n  \"name\": \"Анна\",\n  \"group\": \"p3223\",\n  \"dormitory\": 0,\n  \"country\": \"США\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Ошибки по полям\", () => {",
                  "    pm.expect(pm.response.json().details).to.have.all.keys(\"id\", \"name\", \"group\", \"dormitory\", \"country\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Список: фильтры, поиск, сортировка, страница",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/requests?group=P3223&group=P3224&dormitory=8&search=анна&sort=-room&page=1&size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Найден добавленный студент\", () => {",
                  "    const page = pm.response.json();",
                  "    pm.expect(page.items.map(s => s.id)).to.include(Number(pm.collectionVariables.get(\"studentId\")));",
                  "    pm.expect(page.size).to.eql(10);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Список: неизвестный параметр (400)",
          "request": {
