                ]
              }
            }
          ]
        },
        {
          "name": "Список методом QUERY",
          "request": {
            "method": "QUERY",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group\": [\n    \"P3223\",\n    \"P3224\"\n  ],\n  \"dormitory\": [\n    8\n  ],\n  \"search\": \"смирн\",\n  \"sort\": \"-name\",\n  \"page\": 1,\n  \"size\": 20\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
