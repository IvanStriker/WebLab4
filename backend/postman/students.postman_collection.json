                "exec": [
                  "pm.test(\"Статус 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Students (ADMIN)",
      "item": [
        {
          "name": "Добавить студента",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{studentId}},\n  \"name\": \"Анна Смирнова\",\n  \"group\": \"P3223\",\n  \"dormitory\": 8,\n  \"room\": 412,\n  \"moveinDate\": \"{{moveinDate}}\",\n  \"country\": \"Россия\",\n  \"notes\": \"Староста группы\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"studentId\", 100000 + Math.floor(Math.random() * 900000));",
                  "const date = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set(\"moveinDate\", date.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Есть заголовок Location\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Добавить: ИСУ уже есть (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{studentId}},\n  \"name\": \"Анна Смирнова\",\n  \"group\": \"P3223\",\n  \"dormitory\": 8,\n  \"room\": 412,\n  \"moveinDate\": \"{{moveinDate}}\",\n  \"country\": \"Россия\",\n  \"notes\": \"Староста группы\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
