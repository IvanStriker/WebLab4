          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Обновление после выхода (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
