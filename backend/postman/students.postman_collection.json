        {
          "name": "Заменить студента (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/requests/{{studentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{studentId}},\n  \"name\": \"Анна Иванова\",\n  \"group\": \"P3224\",\n  \"dormitory\": 8,\n  \"room\": 415\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Поля, которых нет в теле, очищены\", () => pm.expect(pm.response.json().notes).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "Изменить часть полей (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/merge-patch+json"
              }
            ],
            "url": "{{baseUrl}}/requests/{{studentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room\": 420,\n  \"notes\": \"Переселена\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Остальные поля не изменились\", () => {",
                  "    const student = pm.response.json();",
                  "    pm.expect(student.room).to.eql(420);",
                  "    pm.expect(student.name).to.eql(\"Анна Иванова\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Изменить: ИСУ менять нельзя (422)",
          "request": {
            "method": "PATCH",
            "header": [
